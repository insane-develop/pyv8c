laHkaJeFuYloZURqeVS\" src=\"/static/js/global.js?v=cf2648d5f46d89e6\"></script>\n<div class=\"body-wrap\">\n<div class=\"body-content\" id=\"main\"><style>\n.sign-in-icons {\nmargin: 0 auto;\ncolor: #fff;\nuser-select: none;\n}\n.btn-steam {\nborder: 0;\nborder-radius: 50px;\nbackground: #377096;\ncolor: #fff;\nfont-size: 16px;\nwidth: 300px;\nmax-width: 100%;\nbox-shadow: none !important;\npadding: 14px 30px;\nfont-weight: normal;\n}\n.sign-in-wrapper {\npadding: 0 15px;\n}\n.sign-in-wrapper .btn-steam .octicon {\nvertical-align: -4px;\n}\n.btn-steam:focus,\n.btn-steam:active,\n.btn-steam:hover,\n.btn-steam.disabled {\ncolor: #000;\nbackground: #CDDC39;\ntext-decoration: underline;\n}\n.btn-steam .loader {\nfilter: invert(1);\n}\n.note {\nmargin: 30px 0;\nwidth: 100%;\n& + .note {\nmargin-top: 0;\n}\n}\n.sign-in-wrapper {\nmargin: 15px auto;\nmin-height: calc(100vh - var(--navbar-height) - 140px);\nmax-width: 450px;\ndisplay: flex;\nflex-direction: column;\nalign-items: center;\njustify-content: center;\n}\n.sign-in-wrapper h2,\n.sign-in-wrapper h3 {\ncolor: var(--contrast-color);\n}\n.sign-in-wrapper .plus {\nmargin: 0 30px;\nvertical-align: middle;\nfont-size: 64px;\n}\n.sign-in-wrapper .octicon {\nvertical-align: middle;\n}\n.sign-in-wrapper .octicon-piston .fill {\nfill: #FFF;\n}\n.sign-in-wrapper .stroke {\nfill: none;\nstroke: #FFF;\n}\n.sign-in-wrapper h1 {\nmargin-top: 30px;\n}\n@media (max-width: 500px) {\n.sign-in-icons .plus {\nmargin: 0 10px;\n}\n.sign-in-icons .octicon {\nwidth: 64px;\nheight: 64px;\n}\n}\n.support-above-footer {\nmargin-top: 0;\n}\n</style>\n<div class=\"sign-in-wrapper\">\n<div class=\"sign-in-icons\">\n<svg width=\"127\" height=\"128\" viewBox=\"0 0 83 84\" class=\"octicon octicon-steamdb\" aria-hidden=\"true\"><path d=\"M41.0645 0C63.7437 0 82.1289 8.45818 82.1289 18.8906C82.1286 23.2692 78.8889 27.2985 73.4531 30.502C78.8892 33.705 82.1287 37.7346 82.1289 42.1133C82.1289 46.4413 78.9631 50.427 73.6406 53.6123C78.963 56.7973 82.128